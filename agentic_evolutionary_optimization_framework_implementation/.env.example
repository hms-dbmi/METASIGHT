# Copy to `.env` and fill in.  `.env` is git-ignored — never commit real keys.
# Fill in for the online pipeline (Stage 1 + Stage 2). `.env` is git-ignored.

# ---- Stage 1: broad exploration (OpenAI-compatible endpoint) ----
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
METASIGHT_STAGE1_MODEL=gpt-5.4-mini

# ---- Stage 2: targeted refinement (Anthropic Claude) — set your Claude model ----
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
METASIGHT_STAGE2_MODEL=
